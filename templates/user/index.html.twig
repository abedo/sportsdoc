{% extends 'base.html.twig' %}

{% block title %}Osoby{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Osoby</h1>
        <a class="btn btn-outline-primary btn-sm" href="{{ path('user_new') }}">+ Dodaj osobę</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white">
            <thead><tr><th>Imię i nazwisko</th><th>E-mail</th><th>Rola</th><th></th></tr></thead>
            <tbody>
            {% for user in users %}
                <tr>
                    <td><a href="{{ path('user_show', {'id': user.id}) }}">{{ user.fullname }}</a></td>
                    <td>{{ user.email ?? '—' }}</td>
                    <td>{% if 'ROLE_ADMIN' in user.roles %}<span class="badge text-bg-dark">administrator</span>{% elseif 'ROLE_ORGANIZER' in user.roles %}<span class="badge text-bg-secondary">organizator</span>{% else %}osoba{% endif %}</td>
                    <td class="text-end"><a class="btn btn-outline-secondary btn-sm" href="{{ path('user_edit', {'id': user.id}) }}">Edytuj</a></td>
                </tr>
            {% else %}
                <tr><td colspan="4" class="text-muted">Brak osób.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
