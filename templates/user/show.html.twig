{% extends 'base.html.twig' %}

{% block title %}{{ user.fullname }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h3 mb-0">{{ user.fullname }}</h1>
            <div class="text-muted">{{ user.email }}{% if 'ROLE_ADMIN' in user.roles %} · <span class="badge text-bg-secondary">organizator</span>{% endif %} · od {{ user.createdAt|date('d.m.Y') }}</div>
        </div>
        <a class="btn btn-outline-secondary btn-sm" href="{{ path('user_edit', {'id': user.id}) }}">Edytuj</a>
    </div>

    <h2 class="h6 text-uppercase text-muted">Rozliczenie</h2>
    {{ include('_partials/balance.html.twig', {balance: balance}) }}

    <div class="d-flex justify-content-between mt-3">
        <a href="{{ path('user_index') }}">Wróć do listy</a>
        {{ include('_partials/delete_form.html.twig', {route: 'user_delete', id: user.id, label: 'Usuń osobę'}) }}
    </div>
{% endblock %}
