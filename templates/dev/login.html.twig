{% extends 'base.html.twig' %}

{% block title %}Logowanie dev{% endblock %}

{% block body %}
    <div class="alert alert-warning">Tryb deweloperski: szybkie logowanie bez Google. Ta strona nie istnieje w produkcji.</div>
    <h1 class="h4">Zaloguj jako</h1>
    <div class="list-group">
        {% for u in users %}
            <a class="list-group-item list-group-item-action d-flex justify-content-between" href="{{ path('dev_login_as', {'id': u.id}) }}">
                <span>{{ u.fullname }} <span class="text-muted small">{{ u.email }}</span></span>
                {% if 'ROLE_ADMIN' in u.roles %}<span class="badge text-bg-secondary">organizator</span>{% endif %}
            </a>
        {% else %}
            <div class="list-group-item text-muted">Brak osób w bazie.</div>
        {% endfor %}
    </div>
{% endblock %}
