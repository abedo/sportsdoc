{% extends 'base.html.twig' %}

{% block title %}Miejsca{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/swiper@11.1.14/swiper-bundle.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Moje miejsca</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="{{ path('place_search') }}">Znajdź miejsce</a>
            {% if is_granted('ROLE_ORGANIZER') %}
                <a class="btn btn-outline-primary btn-sm" href="{{ path('place_new') }}">+ Dodaj miejsce</a>
            {% endif %}
        </div>
    </div>

    {% if cards is empty %}
        <div class="alert alert-info">
            Nie należysz jeszcze do żadnego miejsca.
            <a href="{{ path('place_search') }}">Znajdź miejsce</a>, w którym grasz, i dołącz do niego.
            {% if is_granted('ROLE_ORGANIZER') %}Możesz też <a href="{{ path('place_new') }}">dodać własne</a>.{% endif %}
        </div>
    {% else %}
        <p class="text-muted small mb-2">Przełączaj miejsca strzałkami, klawiszami ← → albo przesunięciem palcem.</p>
        <div class="swiper places-swiper" data-initial="{{ activeIndex }}">
            <div class="swiper-wrapper">
                {% for c in cards %}
                    {% set place = c.place %}
                    <div class="swiper-slide" data-place-id="{{ place.id }}">
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h2 class="h4 mb-1">{{ place.name }}</h2>
                                <p class="text-muted mb-3">{{ place.address }}, {{ place.zip }} {{ place.city }}</p>

                                <div class="row g-2 mb-3">
                                    <div class="col stat"><div class="num">{{ c.gamesTotal }}</div><div class="small text-muted">gier</div></div>
                                    <div class="col stat"><div class="num">{{ c.people }}</div><div class="small text-muted">osób grało</div></div>
                                    <div class="col stat">
                                        <div class="num {{ c.balance.balance < 0 ? 'text-danger' : 'text-success' }}">{{ c.balance.balance }}</div>
                                        <div class="small text-muted">moje saldo</div>
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    {% if is_granted('PLACE_MANAGE', place) %}
                                        <a class="btn btn-success" href="{{ path('game_new', {'place': place.id}) }}">Dodaj grę</a>
                                        <a class="btn btn-outline-secondary" href="{{ path('place_members', {'id': place.id}) }}">Uczestnicy ({{ c.members }})</a>
                                        <a class="btn btn-outline-secondary" href="{{ path('place_edit', {'id': place.id}) }}">Edytuj miejsce</a>
                                        {{ include('_partials/delete_form.html.twig', {route: 'place_delete', id: place.id, label: 'Usuń miejsce'}) }}
                                    {% endif %}
                                    <form method="post" action="{{ path('place_leave', {'id': place.id}) }}" onsubmit="return confirm('Opuścić to miejsce?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('leave' ~ place.id) }}">
                                        <button class="btn btn-outline-danger btn-sm">Opuść miejsce</button>
                                    </form>
                                </div>

                            </div>
                        </div>

                        <div class="card shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-baseline mb-2">
                                    <h3 class="h6 text-uppercase text-muted mb-0">Ostatnie gry</h3>
                                    {% if c.gamesTotal > c.games|length %}
                                        <a class="small" href="{{ path('game_index') }}">Wszystkie gry ({{ c.gamesTotal }})</a>
                                    {% endif %}
                                </div>
                                {% if c.games is empty %}
                                    <p class="text-muted mb-0">Brak gier w tym miejscu.{% if is_granted('PLACE_MANAGE', place) %} Dodaj pierwszą przyciskiem „Dodaj grę”.{% endif %}</p>
                                {% else %}
                                    {% for game in c.games %}
                                        <a class="game-tile" href="{{ path('game_show', {'id': game.id}) }}">
                                            <span class="game-date">{{ game.createdAt|date('d.m.Y') }}</span>
                                            <span class="game-meta">{{ presentCounts[game.id] ?? 0 }} os. · {{ game.cost }} zł</span>
                                            <span class="game-arrow" aria-hidden="true">&rsaquo;</span>
                                        </a>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="swiper-button-prev" aria-label="Poprzednie miejsce"></div>
            <div class="swiper-button-next" aria-label="Następne miejsce"></div>
            <div class="swiper-pagination"></div>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/swiper@11.1.14/swiper-bundle.min.js"></script>
    <script src="{{ asset('js/places.js') }}"></script>
{% endblock %}
