{% extends 'base.html.twig' %}

{% block title %}Znajdź miejsce{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Znajdź miejsce</h1>
        <a href="{{ path('place_index') }}">Moje miejsca</a>
    </div>

    <form method="get" action="{{ path('place_search') }}" class="row g-2 mb-3">
        <div class="col">
            <label class="visually-hidden" for="q">Nazwa lub miasto</label>
            <input class="form-control" type="search" id="q" name="q" value="{{ q }}" placeholder="Nazwa miejsca lub miasto" autofocus>
        </div>
        <div class="col-auto"><button class="btn btn-primary">Szukaj</button></div>
    </form>

    {% if places is empty %}
        <div class="alert alert-info">Nic nie znaleziono{% if q %} dla „{{ q }}”{% endif %}. Spróbuj innej nazwy albo miasta. Jeśli miejsca nie ma, poproś organizatora grupy o jego dodanie.</div>
    {% else %}
        <div class="list-group">
            {% for place in places %}
                <div class="list-group-item d-flex justify-content-between align-items-center gap-3">
                    <div>
                        <div class="fw-semibold">{{ place.name }}</div>
                        <div class="small text-muted">{{ place.address }}, {{ place.zip }} {{ place.city }}</div>
                    </div>
                    {% if mine[place.id] is defined %}
                        <a class="btn btn-outline-secondary btn-sm" href="{{ path('place_index', {place: place.id}) }}">Jesteś w tym miejscu</a>
                    {% else %}
                        <form method="post" action="{{ path('place_join', {'id': place.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('join' ~ place.id) }}">
                            <button class="btn btn-success btn-sm">Dołącz</button>
                        </form>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
        {% if truncated %}<p class="small text-muted mt-2">Pokazano pierwsze 30 wyników. Doprecyzuj wyszukiwanie.</p>{% endif %}
    {% endif %}
{% endblock %}
