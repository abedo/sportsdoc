{% extends 'base.html.twig' %}

{% block title %}Wybierz rolę{% endblock %}

{% block body %}
    <h1 class="h3 mb-1">Witaj, {{ app.user.fullname }}</h1>
    <p class="text-muted">{% if current %}Zmień rolę, jeśli wybrałeś źle.{% else %}Kim jesteś w Sportsdoc? Możesz to później zmienić.{% endif %}</p>

    <form method="post" class="row g-3">
        <input type="hidden" name="_token" value="{{ csrf_token('choose-role') }}">
        <div class="col-md-6">
            <div class="card h-100{{ current == 'organizer' ? ' border-success' }}">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">Jestem organizatorem</h2>
                    <p class="text-muted flex-grow-1">Prowadzę zajęcia. Zakładam miejsca, dodaję gry, zaznaczam obecność i potwierdzam wpłaty.</p>
                    <button class="btn btn-success" name="role" value="organizer">Jestem organizatorem</button>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100{{ current == 'participant' ? ' border-success' }}">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">Jestem uczestnikiem</h2>
                    <p class="text-muted flex-grow-1">Gram w zajęciach. Dołączam do miejsca, zaznaczam swoją obecność i zgłaszam wpłaty.</p>
                    <button class="btn btn-primary" name="role" value="participant">Jestem uczestnikiem</button>
                </div>
            </div>
        </div>
    </form>
    <p class="small mt-3"><a href="{{ path('help') }}">Jak to działa?</a></p>
{% endblock %}
