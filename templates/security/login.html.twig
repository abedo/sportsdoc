{% extends 'base.html.twig' %}

{% block title %}Logowanie{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm mt-4">
                <div class="card-body text-center">
                    <h1 class="h4 mb-3">Sportsdoc</h1>
                    <p class="text-muted">Zaloguj się, żeby zaznaczać obecność na grach i zgłaszać wpłaty.</p>
                    <div class="d-grid gap-2">
                        <a href="{{ path('connect', {provider: 'google'}) }}" class="btn btn-danger">Zaloguj przez Google</a>
                        <a href="{{ path('connect', {provider: 'facebook'}) }}" class="btn btn-primary">Zaloguj przez Facebooka</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
