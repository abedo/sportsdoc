{% extends 'base.html.twig' %}

{% block title %}Nowa gra{% endblock %}

{% block body %}
    <h1 class="h3">Nowa gra: {{ place.name }}</h1>
    <p class="text-muted">{{ place.address }}, {{ place.city }}. Podaj datę. Koszt i obecnych ustawisz w następnym kroku.</p>
    {{ include('game/_form.html.twig', {button_label: 'Dodaj grę'}) }}
    <p class="mt-3"><a href="{{ path('place_index', {place: place.id}) }}">Anuluj</a></p>
{% endblock %}
