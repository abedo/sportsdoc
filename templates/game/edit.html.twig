{% extends 'base.html.twig' %}

{% block title %}Edycja gry{% endblock %}

{% block body %}
    <h1 class="h3">Gra {{ game.createdAt|date('d.m.Y') }}, {{ game.place }}</h1>

    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h6 text-uppercase text-muted">Szczegóły gry</h2>
            {{ include('game/_form.html.twig', {button_label: 'Zapisz zmiany'}) }}
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h6 text-uppercase text-muted">Lista obecności <span class="text-muted">({{ presentCount }} z {{ users|length }})</span></h2>

            {% if users is empty %}
                <p class="text-muted">Brak osób. <a href="{{ path('user_new') }}">Dodaj osobę</a>, żeby zaznaczać obecność.</p>
            {% else %}
                <form method="post" action="{{ path('game_attendance', {'id': game.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('attendance' ~ game.id) }}">
                    <div class="list-group mb-3">
                        {% for u in users %}
                            <label class="list-group-item d-flex align-items-center gap-3" for="present_{{ u.id }}">
                                <input class="form-check-input mt-0" type="checkbox" id="present_{{ u.id }}" name="present[]" value="{{ u.id }}"{{ presence[u.id] ?? false ? ' checked' }}>
                                <span class="flex-grow-1">{{ u.fullname }}</span>
                                {% if presence[u.id] is not defined %}
                                    <span class="small text-muted">nie zaznaczono</span>
                                {% elseif presence[u.id] %}
                                    <span class="small text-success">był</span>
                                {% else %}
                                    <span class="small text-danger">nie był</span>
                                {% endif %}
                            </label>
                        {% endfor %}
                    </div>
                    <button class="btn btn-primary" type="submit">Zapisz obecność</button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="d-flex justify-content-between">
        <a href="{{ path('game_show', {'id': game.id}) }}">Podgląd gry</a>
        {{ include('_partials/delete_form.html.twig', {route: 'game_delete', id: game.id, label: 'Usuń grę'}) }}
    </div>
{% endblock %}
